<%= render "shared/navbar" %>
<%= render 'shared/background' %>


<div class="container">
  <div class="d-flex flex-column align-items-center justify-content-center" style="height: calc(100vh - 116px)">
    <h2>Log in</h2>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { style: "width: 400px;"}) do |f| %>
      <div class="form-inputs">
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    label_html: { class: "text-white" },
                    input_html: { autocomplete: "email" } %>
        <%= f.input :password,
                    required: false,
                    label_html: { class: "text-white" },
                    input_html: { autocomplete: "current-password" } %>
        <%= f.input :remember_me, as: :boolean, label_html: { class: "text-white" }, input_html: { class: "form-check-input" } if devise_mapping.rememberable? %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Log in", class: "btn btn-dark text-white" %>
      </div>
    <% end %>

      <%= render "devise/shared/links" %>
  </div>
</div>

<%= render "shared/footer" %>
