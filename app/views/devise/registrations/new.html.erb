<%= render "shared/navbar" %>
<%= render 'shared/backsignup' %>


  <div class="overlay"></div>
<div class="container">
  <div class="d-flex flex-column align-items-center justify-content-center" style="height: calc(100vh - 116px)">
    <h2>Sign up</h2>

      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { style: "width: 400px;"}) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :email,
                required: true,
                autofocus: true,
                label_html: { class: "text-white" },
                input_html: { autocomplete: "email" }%>
    <%= f.input :password,
                required: true,
                label_html: { class: "text-white" },
                hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                input_html: { autocomplete: "new-password" } %>
    <%= f.input :password_confirmation,
                required: true,
                label_html: { class: "text-white" },
                input_html: { autocomplete: "new-password" } %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "Sign up", class: "text-white"%>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
    </div>
  </div>
<%= render "shared/footer" %>
</div>


<style>
.overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5); /
    z-index: 1;
}

.container {
    position: relative;
    z-index: 2;
}

.d-flex {
    position: relative;
    z-index: 3;
}
</style>
