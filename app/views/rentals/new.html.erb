<%= render "shared/navbar" %>
<%= render 'shared/background' %>

<div class="container mt-5 ">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-lg p-4 rounded-4">
        <div class="card-body">

          <!-- Titre -->
          <h1 class="text-center text-dark fw-bold mb-4">Reservation</h1>

          <!-- Message d'erreur -->
         <% if flash[:notice] || flash[:alert] %>
          <div class="alert <%= flash[:notice] ? 'alert-success' : 'alert-danger' %> position-fixed bottom-0 end-0 p-3 shadow-lg fade show" id="toaster" role="alert">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            <%= flash[:notice] || flash[:alert] %>
          </div>
        <% end %>



          <!-- Formulaire de réservation -->
          <%= form_with model: @rental, url: rentals_path, method: :post,
              data: { controller: "rental-price", rental_price_price_per_day_value: @car.price.to_i }, class: "mt-3" do |f| %>

          <%= f.hidden_field :car_id, value: @car.id %>

          <div class="mb-4">
            <%= f.label :start_date, "Pick-up Date", class: "form-label fw-bold text-secondary" %>
            <%= f.date_field :start_date, required: true,
            class: "form-control p-3 rounded text-secondary",
            data: { controller: "datepicker", action: "input->rental-price#calculate", rental_price_target: "startDate" } %>
          </div>

          <div class="mb-4">
            <%= f.label :end_date, "Return Date", class: "form-label fw-bold text-secondary" %>
            <%= f.date_field :end_date, required: true,
            class: "form-control p-3 rounded text-secondary",
            data: { controller: "datepicker", action: "input->rental-price#calculate", rental_price_target: "endDate" } %>
          </div>

            <!-- Détails du prix -->
          <div class="bg-light p-4 rounded shadow-sm border">
              <p class="mb-2 text-secondary"><strong> Price per day:</strong> <span data-rental-price-target="price"><%= @car.price %></span> €</p>
              <p class="mb-2 text-secondary"><strong> Number of days :</strong> <span data-rental-price-target="days">0</span> jours</p>
              <p class="fw-bold text-secondary"><strong> Total :</strong> <span data-rental-price-target="totalPrice">Calculation in progress...</span> €</p>
            </div>

            <!-- Boutons d'action -->
            <div class="text-center mt-4">
              <%= link_to "Retour", cars_path, class: "btn btn-outline-secondary btn-lg px-4 me-3" %>
              <%= f.submit "Reservation", class: "btn btn-success btn-lg px-5 shadow-sm" %>
            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>
