<%= render "shared/navbar" %>
<%= render 'shared/background' %>

<div class="container mt-5 ">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-lg p-4 rounded-4" data-controller="datepicker">
        <%= simple_form_for [@car, @rental], html: { class: 'card-body' } do |f| %>

          <!-- Titre -->
          <h1 class="text-center text-dark fw-bold mb-4">Reservation</h1>

          <!-- Message d'erreur -->
         <% if flash[:notice] || flash[:alert] %>
          <div class="alert <%= flash[:notice] ? 'alert-success' : 'alert-danger' %> position-fixed bottom-0 end-0 p-3 shadow-lg fade show" id="toaster" role="alert">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            <%= flash[:notice] || flash[:alert] %>
          </div>
        <% end %>


          <div>
            <%= f.input :range do %>
              <%= text_field_tag :range, nil, class: "form-control string required", data: { datepicker_target: "range" } %>
            <% end %>

            <%= f.input :start_date, as: :hidden, input_html: { data: { datepicker_target: "startDate" } }  %>
            <%= f.input :end_date, as: :hidden, input_html: { data: { datepicker_target: "endDate" } } %>
          </div>

          <!-- Détails du prix -->
          <div class="bg-light p-4 rounded shadow-sm border">
            <p class="mb-2 text-secondary"><strong> Price per day:</strong> <span data-datepicker-target="price"><%= @car.price %></span> €</p>
            <p class="mb-2 text-secondary"><strong> Number of days :</strong> <span data-datepicker-target="days">0</span> jours</p>
            <p class="fw-bold text-secondary"><strong> Total :</strong> <span data-datepicker-target="totalPrice">Calculation in progress...</span> €</p>
          </div>

            <!-- Boutons d'action -->
          <div class="text-center mt-4">
            <%= link_to "Retour", cars_path, class: "btn btn-outline-secondary btn-lg px-4 me-3" %>
            <%= f.submit "Reservation", class: "btn btn-success btn-lg px-5 shadow-sm" %>
          </div>

        <% end %>
      </div>
    </div>
  </div>
</div>
