<%= render "shared/navbar" %>
<%= render 'shared/background' %>
<h1 class="text-center my-4 fw-bold text-primary">Booking management</h1>

<div class="container mt-5">
  <div class="row">
    <!-- ✅ Barre de navigation latérale (fixe) -->
    <div class="col-md-3">
      <div class="nav flex-column nav-pills sticky-sidebar shadow-sm p-3 bg-white rounded" id="v-pills-tab" role="tablist" aria-orientation="vertical">
        <button class="nav-link active fw-bold text-dark" id="v-pills-reservations-tab" data-bs-toggle="pill" data-bs-target="#v-pills-reservations" type="button" role="tab">
          My Booking
        </button>
        <button class="nav-link fw-bold text-dark" id="v-pills-loueur-tab" data-bs-toggle="pill" data-bs-target="#v-pills-loueur" type="button" role="tab">
          Host Mode
        </button>
        <%= link_to "Home", root_path, class: "btn btn-secondary mt-3 w-100 fw-bold" %>
      </div>
    </div>

    <!-- ✅ Contenu des Onglets -->
    <div class="col-md-9">
      <div class="tab-content" id="v-pills-tabContent">

        <!-- 📋 Onglet "Mes Réservations" -->
        <div class="tab-pane fade show active" id="v-pills-reservations" role="tabpanel">
          <% if @upcoming_rentals.present? %>
            <h2 class="text-primary fw-bold">Upcoming Booking</h2>
            <div class="row row-cols-1 row-cols-md-3 g-4">
              <% @upcoming_rentals.each do |rental| %>
                <div class="col">
                  <a href="<%= rental_path(rental) %>" class="text-decoration-none">
                    <div class="card rental-card shadow-sm h-100">
                      <div class="card-body text-center">
                        <% if rental.car.images.attached? %>
                          <%= cl_image_tag rental.car.images.first.key, class: "img-fluid rounded", style: "width: 100%; max-height: 180px; object-fit: cover;" %>
                        <% end %>
                        <h5 class="mt-3 text-dark fw-bold"><%= rental.car.desc %></h5>
                        <p class="text-muted">📆 <%= rental.start_date.strftime("%d/%m/%Y") %> - <%= rental.end_date.strftime("%d/%m/%Y") %></p>
                        <p class="fw-bold text-success">💰 <%= number_to_currency(rental.price, unit: "€") %></p>
                      </div>
                    </div>
                  </a>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if @past_rentals.present? %>
            <h2 class="text-secondary fw-bold mt-5">📜 Previous Booking</h2>
            <div class="row row-cols-1 row-cols-md-3 g-4">
              <% @past_rentals.each do |rental| %>
                <div class="col">
                  <a href="<%= rental_path(rental) %>" class="text-decoration-none">
                    <div class="card rental-card shadow-sm h-100 bg-light">
                      <div class="card-body text-center">
                        <% if rental.car.images.attached? %>
                          <%= cl_image_tag rental.car.images.first.key, class: "img-fluid rounded", style: "width: 100%; max-height: 180px; object-fit: cover;" %>
                        <% end %>
                        <h5 class="mt-3 text-dark fw-bold"><%= rental.car.desc %></h5>
                        <p class="text-muted">📆 <%= rental.start_date.strftime("%d/%m/%Y") %> - <%= rental.end_date.strftime("%d/%m/%Y") %></p>
                        <p class="fw-bold text-secondary">💰 <%= number_to_currency(rental.price, unit: "€") %></p>
                      </div>
                    </div>
                  </a>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- 🚗 Onglet "Mode Loueur" -->
        <div class="tab-pane fade" id="v-pills-loueur" role="tabpanel">
          <h2 class="text-primary fw-bold">My Cars</h2>
          <% if @user_cars.present? %>
            <div class="row row-cols-1 row-cols-md-3 g-4">
              <% @user_cars.each do |car| %>
                <div class="col">
                  <a href="<%= car_path(car) %>" class="text-decoration-none">
                    <div class="card shadow-lg h-100 car-card">
                      <div class="card-body text-center">
                        <% if car.images.attached? %>
                          <%= cl_image_tag car.images.first.key, class: "img-fluid rounded", style: "width: 100%; max-height: 180px; object-fit: cover;" %>
                        <% end %>
                        <h5 class="mt-3 text-dark fw-bold"><%= car.phase %></h5>
                        <p>🚗 <%= car.km %> KM - 💰 <%= car.price %>€/day - 📍 <%= car.location %></p>
                      </div>
                    </div>
                  </a>
                </div>
              <% end %>
            </div>
          <% end %>

          <!-- 📋 Tableau "All My Reservations" -->
          <h2 class="text-white fw-bold mt-5">All Booking</h2>
          <% if @all_rentals.present? %>
            <div class="table-responsive">
              <table class="table table-bordered table-striped">
                <thead class="bg-primary text-white">
                  <tr>
                    <th>Status</th>
                    <th>Driver</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Booked on</th>
                    <th>Total Price</th>
                  </tr>
                </thead>
                <tbody>
                  <% @all_rentals.each do |rental| %>
                    <tr>
                      <td><span class="badge <%= rental.status == "confirmed" ? 'bg-success' : 'bg-danger' %>"><%= rental.status.capitalize %></span></td>
                      <td><%= rental.user.email %></td>
                      <td><%= rental.start_date.strftime("%d/%m/%Y") %></td>
                      <td><%= rental.end_date.strftime("%d/%m/%Y") %></td>
                      <td><%= rental.created_at.strftime("%d/%m/%Y") %></td>
                      <td class="fw-bold text-success">💰 <%= number_to_currency(rental.price, unit: "€") %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<%= render "shared/footer" %>
<!-- ✅ CSS -->
<style>
  /* ✅ Barre de navigation latérale fixée */
  .sticky-sidebar {
    position: -webkit-sticky;
    position: sticky;
    top: 80px;
    left: 20px;
    width: 300px;
    z-index: 1000;
    border-radius: 12px;
    margin-top: 50px;
  }

  /* ✅ Boutons de navigation */
  .nav-pills .nav-link {
    border-radius: 10px;
    padding: 12px;
    font-size: 16px;
    transition: all 0.3s ease-in-out;
  }

  .nav-pills .nav-link:hover {
    background-color: #007bff;
    color: white;
  }

  /* ✅ Style des cartes */
  .rental-card, .car-card {
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    border-radius: 12px;
  }

  .rental-card:hover, .car-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
  }
</style>
