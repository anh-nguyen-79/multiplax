<%= render "shared/navbar" %>
<%= render 'shared/background' %>

<div class="container">
  <h1 class="text-center my-4">Review your booking</h1>

    <!-- Colonne des informations -->
    <div class="col-md-6">
      <h3 class="text-center"><%= @car.phase %></h3>
      <p class="text-center text-muted"><%= @car.description %></p>

      <div class="car-details">
        <div class="car-detail-item">
          <i class="fas fa-calendar-alt"></i> <span>Year: <%= @car.year %></span>
        </div>
        <div class="car-detail-item">
          <i class="fas fa-road"></i> <span>Kilometer: <%= @car.km %> km</span>
        </div>
        <div class="car-detail-item">
          <i class="fas fa-euro-sign"></i> <span>Price per day: <%= number_to_currency(@car.price, unit: "€") %></span>
        </div>
        <div class="car-detail-item">
          <i class="fas fa-map-marker-alt"></i> <span>Location: <%= @car.location %></span>
        </div>
      </div>

      <h3 class="text-center text-primary">Rental Period</h3>
      <p><strong>Pick-up Date:</strong> <%= @rental.start_date.strftime("%d/%m/%Y") %></p>
      <p><strong>Return Date:</strong> <%= @rental.end_date.strftime("%d/%m/%Y") %></p>

      <hr>
      <h3 class="text-center text-success">Payment Details</h3>
      <p><strong>Price per day:</strong> <%= @car.price %> €</p>
      <p><strong>Number of Days:</strong> <%= (@rental.end_date - @rental.start_date).to_i %> days</p>
      <h3 class="text-center">
        <span class="total-container">Total: <%= @rental.price %> €</span>
      </h3>

    </div>
  </div>
</div>

<!-- Modal pour annulation -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="cancelModalLabel">Cancellation Confirmation</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Are you sure you want to cancel this booking?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
        <%= link_to "Yes, cancel", cancel_rental_path(@rental), method: :patch, class: "btn btn-danger" %>
      </div>
    </div>
  </div>
</div>

<% if flash[:notice] %>
  <div class="alert alert-success position-fixed bottom-0 end-0 p-3" id="toaster" data-controller="toaster" style="z-index: 1000;">
    <%= flash[:notice] %>
  </div>
<% end %>
