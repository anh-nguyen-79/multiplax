<%= render "shared/navbar" %>
<%= render 'shared/background' %>

<div class="container mt-4">
  <h1 class="text-center my-4">Review your booking</h1>
        <div class="card p-3">
            <div class="row g-0">
                <!-- Image à gauche -->
                <div class="col-md-4">
                  <% if @car.images.attached? && @car.images.first.present? %>
                    <%= cl_image_tag @car.images.first.key, class: "img-fluid rounded", style: "width: 100%; max-height: 250px; object-fit: cover;" %>
                  <% else %>
                    <img src="<%= asset_path 'default_car.png' %>" alt="Default Image" class="img-fluid rounded" style="width: 100%; max-height: 250px; object-fit: cover;">
                  <% end %>
                </div>
                <!-- Contenu à droite -->
                <div class="col-md-8">
                    <div class="card-body">
                      <!-- Description -->
                        <div class="car-details">
                          <h3><%= @car.phase %></h3>
                          <p class="text-muted"><%= @car.description %></p>
                          <div class="car-info"><i class="fas fa-calendar-alt"></i> <span>Year: <%= @car.year %></span></div>
                          <div class="car-info"><i class="fas fa-road"></i> <span>Kilometer: <%= @car.km %> km</span></div>
                          <div class="car-info"><i class="fas fa-euro-sign"></i> <span>Price per day: <%= number_to_currency(@car.price, unit: "€") %></span></div>
                          <div class="car-info"><i class="fas fa-map-marker-alt"></i> <span>Location: <%= @car.location %></span></div>
                          <div class="car-info">
                            <p>
                              <span class="badge
                                <%= case @rental.status
                                    when "pending" then 'bg-warning'
                                    when "confirmed" then 'bg-success'
                                    when "rejected", "canceled" then 'bg-danger'
                                    else 'bg-secondary'
                                    end %>">
                                <%= @rental.status.capitalize %>
                              </span>
                            </p>
                          </div>
                        </div>

                      <!-- Détail -->
                        <div class="car-details">
                          <h3>Rental Period</h3>
                          <p><strong>Pick-up Date:</strong> <%= @rental.start_date.strftime("%d/%m/%Y") %></p>
                          <p><strong>Return Date:</strong> <%= @rental.end_date.strftime("%d/%m/%Y") %></p>
                        </div>
                      <!-- Paiement -->
                        <div class="car-details">
                          <h3>Payment Details</h3>
                          <p><strong>Price per day:</strong> <%= @car.price %> €</p>
                          <p><strong>Number of Days:</strong> <%= (@rental.end_date - @rental.start_date).to_i %> days</p>
                          <h3 class="text-center"><strong>Total:</strong> <%= @rental.price %> €</h3>
                        </div>
                      <!-- Boutons -->
                        <div class="d-flex justify-content-evenly">
                          <%= link_to "Back", cars_path, class: "btn btn-secondary w-30" %>

                          <% unless @rental.status == "canceled" %>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editModal">Edit</button>
                          <% end %>

                          <% if @rental.status == "confirmed" %>
                            <button class="btn btn-danger w-30" data-bs-toggle="modal" data-bs-target="#cancelModal">Cancel</button>
                          <% end %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

<!-- Modal pour annulation -->
<div class="modal fade" id="cancelModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Cancellation Confirmation</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body"> Are you sure you want to cancel this booking? </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
        <%= link_to "Yes, cancel", cancel_rental_path(@rental), method: :patch, class: "btn btn-danger" %>
      </div>
    </div>
  </div>
</div>

<!-- Modal pour modification -->
<div class="modal fade" id="editModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit the booking</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="text-center">
          <% if @car.images.attached? && @car.images.first.present? %>
            <%= cl_image_tag @car.images.first.key, class: "img-fluid rounded", style: "max-height: 250px; object-fit: cover;" %>
          <% else %>
            <img src="<%= asset_path 'default_car.png' %>" class="img-fluid rounded" style="max-height: 250px; object-fit: cover;">
          <% end %>
        </div>

        <%= form_with model: @rental, url: rental_path(@rental), method: :patch do |f| %>
          <div class="mb-3">
            <%= f.label :start_date, "Pick-up Date" %>
            <%= f.date_field :start_date, class: "form-control", required: true %>
          </div>
          <div class="mb-3">
            <%= f.label :end_date, "Return Date" %>
            <%= f.date_field :end_date, class: "form-control", required: true %>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <%= f.submit "Save changes", class: "btn btn-outline-success" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- ✅ UX : Boutons "Reject" & "Validate" en ligne -->
<% if @rental.status == "pending" %>
  <div class="d-flex justify-content-center mt-4">
    <%= button_to "✔ Validate", validate_rental_path(@rental), method: :patch, class: "btn btn-success mx-2" %>
    <%= button_to "✖ Reject", reject_rental_path(@rental), method: :patch, class: "btn btn-danger mx-2" %>
  </div>
<% end %>

<!-- Toaster pour les notifications -->

<% if flash[:notice] || flash[:alert] %>
  <div class="alert <%= flash[:notice] ? 'alert-success' : 'alert-danger' %> position-fixed bottom-0 end-0 p-3 shadow-lg fade show" id="toaster" role="alert">
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    <%= flash[:notice] || flash[:alert] %>
  </div>
<% end %>


<%= render "shared/footer" %>
