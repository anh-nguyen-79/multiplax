<%= render "shared/navbar" %>
<%= render 'shared/background' %>

<h2 class="text-center my-4" style="font-size: 40px; font-weight: bold;">Find the perfect car near you</h2>

<% if notice %>
  <div class="alert alert-success text-center">
    <%= notice %>
  </div>
<% end %>

<div class="home-container">
  <%= render 'shared/background' %>

  <div class="search-section">
    <div class="search-container" data-controller="search">
      <div class="location-search-bar">
        <%= form_tag cars_path, method: :get, class: "d-flex", id: "search-form", data: { search_target: "form" } do %>
          <%= text_field_tag :query,
            params[:query],
            class: "form-control",
            placeholder: "Enter a location (e.g. Paris, Marseille)",
            data: { search_target: "location", action: "change->search#search" }
          %>
          <%= date_field_tag :start_date,
            params[:start_date],
            class: "form-control",
            placeholder: "Start Date",
            data: { search_target: "startDate", action: "change->search#dateChanged" }
          %>
          <%= date_field_tag :end_date,
            params[:end_date],
            class: "form-control",
            placeholder: "End Date",
            data: { search_target: "endDate", action: "change->search#dateChanged" }
          %>
          <button type="submit" class="btn btn-primary search-btn">
            <i class="fas fa-search"></i> Search
          </button>
          
          <% if params[:query].present? || params[:start_date].present? || params[:end_date].present? %>
            <button class="btn btn-outline-secondary" data-action="click->search#clearFilters">
              <i class="fas fa-times"></i> Clear
            </button>
          <% end %>
        <% end %>
      </div>

      <div class="toggle-container" data-controller="toggle">
        <% if user_signed_in? %>
          <button type="button" class="btn-rainbow" data-action="click->toggle#fire">
            Add a new car
          </button>
        <% else %>
          <%= link_to 'Add a car', new_user_session_path, class: "btn-rainbow" %>
        <% end %>

        <div data-toggle-target="togglableElement" class="car-form-container d-none">
          <%= render "form", car: @car %>
        </div>
      </div>
    
    </div>
  </div>

  <div class="split-layout-container">
    <div class="cars-content">
      <div class="cars-grid">
        <% @cars.each do |car| %>
          <div class="car-card">
            <div class="car-image" style="background-image: url('<%= cl_image_path car.images.first.key if car.images.attached? %>')">
              <div class="car-price">
                <span><%= car.price %>€</span>
                <small>/day</small>
              </div>
            </div>

            <div class="car-info">
              <h3><%= car.phase %></h3>
              <div class="car-details">
                <span><i class="fas fa-map-marker-alt"></i> <%= car.location %></span>
              </div>
            </div>

            <%= link_to "", car_path(car), class: "card-link" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="map-container">
      <div
        data-controller="map"
        data-map-markers-value="<%= @markers.to_json %>"
        data-map-api-key-value="<%= ENV['MAPBOX_ACCESS_TOKEN'] %>"
        class="sticky-map"
      ></div>
    </div>
  </div>
</div>

<!-- Afficher les résultats de recherche -->
<div data-search-target="results">
  <% if params[:query].present? || params[:start_date].present? || params[:end_date].present? %>
    <div class="search-results-info">
      <h3>
        <%= @cars.count %> cars available
        <% if params[:query].present? %>
          in "<%= params[:query] %>"
        <% end %>
        <% if params[:start_date].present? && params[:end_date].present? %>
          from <%= params[:start_date] %> to <%= params[:end_date] %>
        <% end %>
      </h3>
    </div>
  <% end %>
</div>

<%= render "shared/footer" %>

