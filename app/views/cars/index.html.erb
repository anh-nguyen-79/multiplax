<%= render "shared/navbar" %>
<%= render 'shared/background' %>

<h2 class="text-center my-4" style="font-size: 40px; font-weight: bold;">Find the perfect car near you</h2>

<% if notice %>
  <div class="alert alert-success text-center">
    <%= notice %>
  </div>
<% end %>

<div class="home-container">
  <%= render 'shared/background' %>

  <div class="search-section">
    <div class="search-container">
      <div class="location-search-bar">
        <%= form_tag cars_path, method: :get, class: "d-flex" do %>
          <%= text_field_tag :query,
            params[:query],
            class: "form-control",
            placeholder: "Location (default: Paris)"
          %>
          <%= date_field_tag :start_date,
            params[:start_date],
            class: "form-control",
            placeholder: "Start Date"
          %>
          <%= date_field_tag :end_date,
            params[:end_date],
            class: "form-control",
            placeholder: "End Date"
          %>
          <!-- faut avoir summit bouton? -->
        <% end %>
      </div>

      <div data-controller="toggle">
        <% if user_signed_in? %>
          <button type="button" class="btn-rainbow" data-action="click->toggle#fire">
            Add a new car
          </button>
        <% else %>
          <%= link_to 'Add a car', new_user_session_path, class: "btn-rainbow" %>
        <% end %>

        <div data-toggle-target="togglableElement" class="car-form-container d-none">
          <%= render "form", car: @car %>
        </div>
      </div>
    </div>
  </div>

  <div class="filters-section">
    <div class="filters-container" data-controller="filters">
      <div class="filter-buttons">
        <button data-action="click->filters#togglePrice" class="filter-button">
          <i class="fi fi-ts-money-bill-wave"></i> Price <i class="fi fi-sr-angle-small-down"></i>
        </button>
        <button data-action="click->filters#toggleKm" class="filter-button">
          <i class="fi fi-ts-road"></i> Kilometers <i class="fi fi-sr-angle-small-down"></i>
        </button>
        <button data-action="click->filters#togglePhase" class="filter-button">
          <i class="fi fi-ts-car"></i> Phase <i class="fi fi-sr-angle-small-down"></i>
        </button>
        <button data-action="click->filters#toggleYear" class="filter-button">
          <i class="fi fi-ts-calendar"></i> Year <i class="fi fi-br-angle-small-down"></i>
        </button>
      </div>

      <%= form_tag cars_path, method: :get, class: "filters-form" do %>
        <div data-filters-target="priceFilter" class="filter-panel d-none">
          <h4>Price</h4>
          <%= range_field_tag :price_min, params[:price_min], min: 0, max: 500, class: "range-slider" %>
          <span class="price-value"><%= params[:price_min] || 0 %>€ - 500€</span>
        </div>

        <div data-filters-target="kmFilter" class="filter-panel d-none">
          <h4>Kilometers</h4>
          <%= range_field_tag :km_min, params[:km_min], min: 0, max: 100000, class: "range-slider" %>
          <span class="km-value"><%= params[:km_min] || 0 %> km - 100,000 km</span>
        </div>

        <div data-filters-target="phaseFilter" class="filter-panel d-none">
          <h4>Phase</h4>
          <%= select_tag :phase, options_for_select(['New', 'Used'], params[:phase]), include_blank: true, class: "form-control" %>
        </div>

        <div data-filters-target="yearFilter" class="filter-panel d-none">
          <h4>Year</h4>
          <%= select_tag :year, options_for_select((2000..Date.today.year).to_a.reverse, params[:year]), include_blank: true, class: "form-control" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="split-layout-container">
    <div class="cars-content">
      <div class="cars-grid">
        <% @cars.each do |car| %>
          <div class="car-card">
            <div class="car-image" style="background-image: url('<%= cl_image_path car.images.first.key if car.images.attached? %>')">
              <div class="car-price">
                <span><%= car.price %>€</span>
                <small>/day</small>
              </div>
            </div>

            <div class="car-info">
              <h3><%= car.phase %></h3>
              <div class="car-details">
                <span><i class="fas fa-map-marker-alt"></i> <%= car.location %></span>
              </div>
            </div>

            <%= link_to "", car_path(car), class: "card-link" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="map-container">
      <div
        data-controller="map"
        data-map-markers-value="<%= @markers.to_json %>"
        data-map-api-key-value="<%= ENV['MAPBOX_ACCESS_TOKEN'] %>"
        class="sticky-map"
      ></div>
    </div>
  </div>
</div>

<%= render "shared/footer" %>

