  <div class="progress-container mb-4">
    <div class="progress">
      <div class="progress-bar" role="progressbar" style="width: 0%" data-car-form-target="progress"></div>
    </div>

  <%= form_with(model: @car, html: { class: "needs-validation", novalidate: true, data: { car_form_target: "form" } }) do |form| %>
    <% if @car.errors.any? %>
      <div class="alert alert-danger">
        <h4><%= pluralize(@car.errors.count, "error") %> prohibited this car from being saved:</h4>
        <ul>
          <% @car.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Step 1: Basic Information -->
    <div class="form-step" data-car-form-target="step">
      <h3 class="mb-4">Your car's information</h3>
      
      <div class="form-group mb-3">
        <%= form.label :Phase, class: "form-label" %>
        <%= form.text_field :phase, class: "form-control", required: true %>
      </div>

      <div class="form-group mb-3">
        <%= form.label :Kilometers, class: "form-label" %>
        <%= form.text_field :km, class: "form-control", required: true %>
      </div>

      <div class="form-group mb-3">
        <%= form.label :Year, class: "form-label" %>
        <%= form.number_field :year, class: "form-control", min: 1900, max: Date.today.year, required: true %>
      </div>
    </div>

    <!-- Step 2: Additional Details -->
    <div class="form-step d-none" data-car-form-target="step">
      <h3 class="mb-4">Additional Details</h3>
      
      <div class="form-group mb-3">
        <%= form.label :Price, class: "form-label" %>
        <div class="input-group">
          <span class="input-group-text">€</span>
          <%= form.number_field :price, class: "form-control", min: 1, required: true %>
        </div>
      </div>

      <div class="form-group mb-3">
        <%= form.label :Location, class: "form-label" %>
        <%= form.text_field :location, class: "form-control", required: true %>
      </div>
    </div>

    <!-- Step 3: Car Photos -->
    <div class="form-step d-none" data-car-form-target="step">
      <h3 class="mb-4">Upload Photos</h3>
      
      <div class="form-group mb-3">
        <%= form.label :photos, class: "form-label" %>
        <%= form.file_field :photos, multiple: true, class: "form-control", direct_upload: true %>
      </div>

      <div class="form-group mb-3">
        <%= form.label :description, class: "form-label" %>
        <%= form.text_area :description, class: "form-control", rows: 4 %>
      </div>
    </div>

    <div class="form-actions mt-4 d-flex justify-content-between">
      <%= link_to "Back", cars_path, class: "btn btn-outline-secondary", data: { action: "click->car-form#backToIndex" } %>
      
      <div>
        <button type="button" class="btn btn-outline-primary d-none" data-car-form-target="prevButton" data-action="click->car-form#prev">Previous</button>
        <button type="button" class="btn btn-primary" data-car-form-target="nextButton" data-action="click->car-form#next">Next</button>
        <%= form.submit "List Your Car", class: "btn btn-success d-none", data: { car_form_target: "submitButton" } %>
      </div>
    </div>
  <% end %>
</div>
