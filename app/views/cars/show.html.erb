<%= render "shared/navbar" %>
<%= render 'shared/background' %>

<div class="container mt-5">
  <% if notice %>
    <div class="alert alert-success text-center">
      <%= notice %>
    </div>
  <% end %>

  <h1 class="text-primary fw-bold text-center mb-4"><%= @car.phase %></h1>

  <div class="row align-items-center">
    <div class="col-md-6 d-flex justify-content-center">
      <% if @car.images.attached? %>
        <div id="carCarousel" class="carousel slide rounded-3 shadow-sm w-100" data-bs-ride="carousel" style="max-width: 500px;">
          <div class="carousel-inner">
            <% @car.images.each_with_index do |image, index| %>
              <div class="carousel-item <%= 'active' if index == 0 %>">
                <%= cl_image_tag image.key, class: 'd-block w-100', style: 'height: 400px; object-fit: cover; border-radius: 12px;' %>
              </div>
            <% end %>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#carCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#carCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
      <% else %>
        <div class="no-image bg-light text-center py-5 rounded-3 shadow-sm w-100" style="max-width: 500px;">
          <i class="fas fa-car fa-3x text-muted"></i>
          <p class="mt-2">Aucune image disponible</p>
        </div>
      <% end %>
    </div>

    <div class="col-md-6">
      <div class="card shadow-lg bg-white p-3 rounded-3 mb-3">
        <div class="card-body">
          <h3 class="text-primary">Détails</h3>
          <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Year :</strong> <%= @car.year %></li>
            <li class="list-group-item"><strong>Kilometers :</strong> <%= @car.km %> km</li>
            <li class="list-group-item"><strong>Price per day :</strong> <%= number_to_currency(@car.price, unit: "€") %></li>
            <li class="list-group-item"><strong>Location :</strong> <%= @car.location %></li>
          </ul>
        </div>
      </div>

      <div class="card shadow-lg bg-white p-3 rounded-3">
        <div class="card-body">
          <h3 class="text-primary">Description</h3>
          <p class="text-muted"><%= @car.description.presence || "Aucune description fournie" %></p>
        </div>
      </div>
    </div>
  </div>


  <div class="d-flex justify-content-center mt-4">
    <%= link_to 'Rent Now', new_rental_path(car_id: @car.id), class: 'btn-rainbow' %>
  </div>

  <div class="mt-5 text-center">
    <%= link_to '⬅ Retour', cars_path, class: 'btn btn-secondary' %>
  </div>
</div>

<style>
  .btn-rainbow {
    font-size: 20px;
    font-weight: bold;
    padding: 12px 24px;
    border: none;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    background: linear-gradient(90deg, #ff0000, #ff7300, #ffea00, #00ff00, #0099ff, #5b00ff, #ff00ff);
    background-size: 400%;
    color: white;
    transition: 0.4s ease-in-out;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
  }

  .btn-rainbow:hover {
    animation: rainbow 3s infinite linear;
    transform: scale(1.05);
  }

  @keyframes rainbow {
    0% { background-position: 0%; }
    100% { background-position: 400%; }
  }
</style>
