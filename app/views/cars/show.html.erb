<style>
  .btn-rainbow {
    font-size: 20px;
    font-weight: bold;
    padding: 12px 24px;
    border: none;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    background: linear-gradient(90deg, #ff0000, #ff7300, #ffea00, #00ff00, #0099ff, #5b00ff, #ff00ff);
    background-size: 400%;
    color: white;
    transition: 0.4s ease-in-out;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
  }

  .btn-rainbow:hover {
    animation: rainbow 3s infinite linear;
    transform: scale(1.05);
  }

  @keyframes rainbow {
    0% { background-position: 0%; }
    100% { background-position: 400%; }
  }
</style>
