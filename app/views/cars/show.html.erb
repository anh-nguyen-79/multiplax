<%= render "shared/navbar" %>
<%= render 'shared/background' %>


<div class="container mt-5">
  <% if notice %>
    <div class="alert alert-success text-center">
      <%= notice %>
    </div>
  <% end %>

  <div class="card shadow-lg p-4 rounded-3">
    <!-- Titre -->
    <h1 class="text-primary fw-bold text-center"><%= @car.phase %></h1>

    <!-- Images de la voiture -->
    <div class="car-images mb-4">
      <% if @car.images.attached? %>
        <div id="carCarousel" class="carousel slide rounded-3 shadow-sm" data-bs-ride="carousel">
          <div class="carousel-inner">
            <% @car.images.each_with_index do |image, index| %>
              <div class="carousel-item <%= 'active' if index == 0 %>">
                <%= cl_image_tag image.key, class: 'd-block w-100', style: 'height: 450px; object-fit: cover; border-radius: 12px;' %>
              </div>
            <% end %>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#carCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#carCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
      <% else %>
        <div class="no-image bg-light text-center py-5 rounded-3 shadow-sm">
          <i class="fas fa-car fa-3x text-muted"></i>
          <p class="mt-2">Aucune image disponible</p>
        </div>
      <% end %>
    </div>

    <!-- Détails de la voiture -->
    <div class="row mt-3">
      <div class="col-md-6">
        <h3 class="text-primary">📋 Details</h3>
        <ul class="list-group list-group-flush">
          <li class="list-group-item"><strong>🗓 Year :</strong> <%= @car.year %></li>
          <li class="list-group-item"><strong>🚗 Kilométrage :</strong> <%= @car.km %> km</li>
          <li class="list-group-item"><strong>💰 Price per day :</strong> <%= number_to_currency(@car.price, unit: "€") %></li>
          <li class="list-group-item"><strong>📍 Location :</strong> <%= @car.location %></li>
        </ul>
      </div>
      <div class="col-md-6">
        <h3 class="text-primary">📝 Description</h3>
        <div class="card shadow-sm">
          <div class="card-body">
            <p class="text-muted"><%= @car.description.presence || "Aucune description fournie" %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Boutons d'action -->
    <div class="mt-4 d-flex flex-wrap gap-2">
      <%= link_to '⬅ Retour', cars_path, class: 'btn btn-secondary' %>

      <% if user_signed_in? && @car.user == current_user %>
        <%= link_to '✏ Edit', edit_car_path(@car), class: 'btn btn-warning' %>
        <%= button_to '🗑 Delete', car_path(@car), method: :delete,
                    data: { turbo_confirm: 'Are you sure you want to delete this car?' },
                    class: 'btn btn-danger' %>
      <% else %>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#rentalModal">
          🚀 Rent now
        </button>
      <% end %>
    </div>
  </div>
</div>

<div class="modal fade" id="rentalModal" tabindex="-1" aria-labelledby="rentalModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <%= form_with model: @rental, url: rentals_path, method: :post, data: { controller: "rental-price", rental_price_price_per_day_value: @car.price.to_i }, class: "mt-3" do |f| %>
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="rentalModalLabel">Reservation</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">

          <%= f.hidden_field :car_id, value: @car.id %>

          <div class="mb-4">
            <%= f.label :start_date, "Pick-up Date", class: "form-label fw-bold text-secondary" %>
            <%= f.date_field :start_date, required: true, class: "form-control p-3 rounded text-secondary",
                data: { action: "input->rental-price#calculate", rental_price_target: "startDate" } %>
          </div>

          <div class="mb-4">
            <%= f.label :end_date, "Return Date", class: "form-label fw-bold text-secondary" %>
            <%= f.date_field :end_date, required: true, class: "form-control p-3 rounded text-secondary",
                data: { action: "input->rental-price#calculate", rental_price_target: "endDate" } %>
          </div>

          <!-- Détails du prix -->
          <div class="bg-light p-4 rounded shadow-sm border">
            <p class="mb-2 text-secondary"><strong> Price per day:</strong> <span data-rental-price-target="price"><%= @car.price %></span> €</p>
            <p class="mb-2 text-secondary"><strong> Number of days :</strong> <span data-rental-price-target="days">0</span> jours</p>
            <p class="fw-bold text-secondary"><strong> Total :</strong> <span data-rental-price-target="totalPrice">Calculation in progress...</span> €</p>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Reservation", class: "btn btn-success shadow-sm" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Styles améliorés -->
<style>
  .card {
    border-radius: 15px;
  }

  .carousel-control-prev-icon,
  .carousel-control-next-icon {
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 50%;
  }

  .no-image {
    height: 450px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
