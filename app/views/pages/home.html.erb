<div class="wrap-home">
  <%= render "shared/navbar" %>
  <div class="image-container">
    <div class="header">
    </div>
    <div class="search-bar-container">
      <div class="search-container" data-controller="home-search" >
        <%= form_tag cars_path, method: :get, class: "search-form", data: { home_search_target: "form" } do %>
          <div class="search-input-container" style="display: contents">
            <%= text_field_tag :query, 
              params[:query], 
              class: "search-input", 
              placeholder: "Where do I want my Multipla?",
              data: { home_search_target: "location" } 
            %>
            <button type="submit" class="search-icon">
            </button>
          </div>
        <% end %>
      </div>



      
    </div>
  </div>
  <div class="footer">
    <%= render "shared/footer" %>
  </div>
</div>
